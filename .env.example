# Public site URL — canonical URLs, sitemap.xml, robots.txt and Open Graph tags.
# OPTIONAL: this only overrides `url` in content/site.ts. Setting the client's
# domain there is enough, and avoids a hosting-dashboard step. Use this when a
# preview deployment should advertise its own URL instead of production's.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=

# Where contact form submissions go.
#
# The browser posts to /api/contact, which validates, applies the honeypot, then
# forwards here. Keeping the form service behind our own route means the access
# key never reaches the browser and spam is filtered before it costs a quota.
#
# Web3Forms:   https://api.web3forms.com/submit
# Formspree:   https://formspree.io/f/YOUR_FORM_ID
# Or any URL that accepts a JSON POST (Zapier, Make, n8n, your CRM).
CONTACT_FORM_WEBHOOK_URL=

# Access key for the form service above, if it needs one (Web3Forms does).
# Sent as `access_key` in the payload. This is a secret: set it in the hosting
# project's environment, never in the repository.
CONTACT_FORM_ACCESS_KEY=

# Optional: analytics and search console verification.
# Leave blank to omit the tags entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
