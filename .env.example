# Public site URL — used for canonical URLs, sitemap.xml, robots.txt and Open Graph tags.
# No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.example-cpa.com

# Optional: where contact form submissions are forwarded.
# The bundled /api/contact route validates and logs submissions; wire this up to your
# CRM, help desk, or transactional email provider before going live.
CONTACT_FORM_WEBHOOK_URL=

# Optional: analytics / verification IDs (leave blank to omit the tags entirely).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GOOGLE_SITE_VERIFICATION=
